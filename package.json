{
  "name": "shopping-website",
  "version": "1.0.0",
  "description": "A simple shopping website with a shopping cart feature.",
  "main": "src/main.jsx",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src server e2e *.mjs scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
